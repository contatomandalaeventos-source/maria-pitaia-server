# Servidor
NODE_ENV=production
PORT=3000

# Banco de Dados PostgreSQL
# Copie o DATABASE_URL do Railway
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Evolution API (WhatsApp)
# Crie uma instância no Evolution API específica para Maria Pitaia
EVOLUTION_API_URL=https://seu-evolution-server.com
EVOLUTION_API_TOKEN=seu_token_aqui
EVOLUTION_INSTANCE_NAME=maria_pitaia_whatsapp

# WhatsApp de Maria
WHATSAPP_NUMERO=5511985264683
WHATSAPP_NOME=Maria Pitaia Criações

# Email
EMAIL_USER=contato@mariapitaia.com.br
EMAIL_PASSWORD=sua_senha_app_email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# n8n Webhooks
N8N_WEBHOOK_URL=https://seu-n8n-server.com/webhook/maria-pitaia
